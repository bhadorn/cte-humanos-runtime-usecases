        {
          "Id": "8e0b658c-a63d-4b1f-8c71-a5bb4fdd13a0",
          "Name": "MachineStateProcessor",
          "InitialData": [
            "IsPowerOn == false => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "AlarmState != 0    => OutputMachineState=1;   OutputMachineStateName=\"Disturbance\"",
            "IsCharging == true => OutputMachineState=100; OutputMachineStateName=\"Charching\"",
            "RunningState == 1  => OutputMachineState=230; OutputMachineStateName=\"Transporting\"",
            "RunningState == 2  => OutputMachineState=300; OutputMachineStateName=\"Transporting Stopped\"",
            "=> OutputMachineState=340; OutputMachineStateName=\"Stopped: Missing Job\""
          ],
          "Type": "SituationProcessingNode",
          "Ports": [
