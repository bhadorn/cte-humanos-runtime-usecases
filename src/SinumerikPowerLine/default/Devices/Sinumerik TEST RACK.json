            "AlarmState == 2     => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "OperationMode != 2  => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == 2 and RunningState == 2 => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == 2 and RunningState == 1 => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == 2 and RunningState == 3 => OutputMachineState=310; OutputMachineStateName=\"Stopped: Missing Material\"",
            "OperationMode == 2 => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\""
