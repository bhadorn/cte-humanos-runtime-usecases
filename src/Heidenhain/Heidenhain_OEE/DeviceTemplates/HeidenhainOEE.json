          "Name": "MachineStateProcessor",
          "InitialData": [
            "AvailableState <= 0 => OutputMachineState=900; OutputMachineStateName=\"Power Off\"",
            "RunningState == 5   => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "EmergencyState != 0 => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "OperationMode != 4  => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == 4 and RunningState == 1 and SpindleOverride == 0.0 => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\"",
            "OperationMode == 4 and RunningState == 1 and CurrentProgram.Contains(\"warmlauf\", StringComparison.OrdinalIgnoreCase) => OutputMachineState=110; OutputMachineStateName=\"Warmup\"",
            "OperationMode == 4 and RunningState == 1 and AlarmState != 0 => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "OperationMode == 4 and RunningState == 1 => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == 4 and RunningState == 2 => OutputMachineState=300; OutputMachineStateName=\"Production Stopped\"",
            "OperationMode == 4 and RunningState == 4 => OutputMachineState=310; OutputMachineStateName=\"Stopped: Missing Material\"",
            "OperationMode == 4 and RunningState == 6 => OutputMachineState=110;OutputMachineStateName=\"Warmup\"",
            "OperationMode == 4 => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\""
          ],
          "Type": "SituationProcessingNode",
