{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "$(AppConfig:Log:MinimumLevel)",
      "Override": {
        "Microsoft": "Warning",
        "System": "Fatal",
        "System.Net.Http.HttpClient": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {LoggerName}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Application}/{MachineName} [{ThreadId}] {SourceContext} {Message:lj} {NewLine}{Exception}",
          "path": "$(AppConfig:CommonAppPath)Logs\\$(HumanOS:ServiceName)-.log",
          "fileSizeLimitBytes": null,
          "rollingInterval": "Day",
          "retainedFileCountLimit": "$(AppConfig:Log:RetentionDays)",
          "rollOnFileSizeLimit": "false",
          "shared": "true",
          "flushToDiskInterval": "00:00:01"
        }
      }
    ],
    "Enrich": [ "WithMachineName", "WithEnvironmentUserName", "WithThreadId" ],
    "Properties": {
      "Application": "HumanOS"
    }
  },
  "HumanOS": {
    "ServiceId": "4d5e6f70-8192-4a3b-5c6d-7e8f9a0b1c2d",
    "ServiceName": "HumanOS.IoT.Gateway",
    "ProgramDataPath": "$(AppConfig:CommonAppPath)",
    "ConfigPath": "$(MainPath)Config\\",
    "PluginPath": "$(MainPath)",
    "LocalNodeSpace": {
      "Type": "HumanOS.Kernel.DataModel.Space.TInMemoryNodeSpace, HumanOS.Kernel"
    },
    "SharedNodeSpace": {
      "Type": "",
      "Address": "localhost"
    },
    "Repository": {
      "Type": "",
      "Path": "DataRepository\\",
      "Connection": "",
      "Prefix": "$(HumanOS:ServiceName)",
      "CleanMode": "CleanNodeRepository"
    },
    "Plugins": {
      "ServicePluginManager": {
        "SearchPattern": "HumanOS.PeSeL.*.dll"
      },
      "DriverPluginManager": {
        "SearchPattern": "HumanOS.UHAL.*.dll"
      },
      "DeviceDetectorPluginManager": {
        "SearchPattern": "HumanOS.UHAL.*.dll"
      },
      "DataBasePluginManager": {
        "SearchPattern": "HumanOS.PeMiL.*.dll"
      },
      "DataObjectPluginManager": {
        "SearchPattern": "HumanOS.PeMiL.*.dll"
      },
      "ProcessorPluginManager": {
        "SearchPattern": "HumanOS.PeMiL.*.dll"
      }
    }
  },
  "LicenseManager": {
    "Source": "LocalFile",
    "Path": "$(AppConfig:CommonAppPath)Licenses\\"
  },
  "AppConfig": {
    "CommonAppPath": "$(MainPath)Data\\",
    "CertificatePath": "$(MainPath)Certificates\\",
    "Log": {
      "MinimumLevel": "Debug",
      "RetentionDays": 7
    }
  }
}
