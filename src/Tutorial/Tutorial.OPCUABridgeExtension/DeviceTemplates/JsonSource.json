          "Id": "8f3188ef-8f33-462d-9fe5-558968876294",
          "Name": "MachineStateProcessor",
          "InitialData": [
            "Alarm != 0 and Alarm <= 98 => OutputMachineState=999; OutputMachineStateName=\"Error\"",
            "Alarm != 0 and Alarm > 98 => OutputMachineState=999; OutputMachineStateName=\"Emergency\"",
            "RunningState == 0   => OutputMachineState=1; OutputMachineStateName=\"Disturbance\"",
            "OperationMode != 4  => OutputMachineState=100; OutputMachineStateName=\"Setup\"",
            "OperationMode == 4 and RunningState == 1 => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Personal\"",
            "OperationMode == 4 and RunningState == 2 => OutputMachineState=110; OutputMachineStateName=\"Warmup\"",
            "OperationMode == 4 and RunningState == 3 => OutputMachineState=200; OutputMachineStateName=\"Production\"",
            "OperationMode == 4 and RunningState > 3 => OutputMachineState=320; OutputMachineStateName=\"Stopped: Missing Material\""
          ],
          "Type": "SituationProcessingNode",
